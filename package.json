{
  "name": "systemverilog-lsp",
  "displayName": "SystemVerilog LSP (RtlEditor2)",
  "description": "SystemVerilog language server (definition, references, hover, document symbols) backed by RtlEditor2 SystemVerilogLanguageServer",
  "version": "0.1.0",
  "publisher": "rtleditor2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajkfds/RtlEditor2.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/ajkfds/RtlEditor2/tree/main/vscode-extension",
  "bugs": {
    "url": "https://github.com/ajkfds/RtlEditor2/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:systemverilog",
    "onLanguage:verilog",
    "onView:systemverilogLsp.hierarchy",
    "onView:systemverilogLsp.messageView"
  ],
  "main": "./extension.js",
  "contributes": {
    "grammars": [
      {
        "language": "systemverilog-hover",
        "scopeName": "source.systemverilog.hover",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "submenus": [
      {
        "id": "systemverilogLsp.hierarchySubmenu.add",
        "label": "Add"
      },
      {
        "id": "systemverilogLsp.hierarchySubmenu.simulation",
        "label": "Simulation"
      }
    ],
    "viewsContainers": {
      "auxiliarybar": [
        {
          "id": "systemverilogLsp-messagesContainer",
          "title": "SystemVerilog Messages",
          "icon": "icons/systemverilog-document.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "systemverilogLsp.hierarchy",
          "name": "RTL Hierarchy",
          "icon": "$(type-hierarchy)",
          "contextualTitle": "RTL Hierarchy"
        }
      ],
      "systemverilogLsp-messagesContainer": [
        {
          "id": "systemverilogLsp.messageView",
          "name": "Messages",
          "type": "webview",
          "contextualTitle": "SystemVerilog Messages"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "systemverilogLsp.hierarchy",
        "contents": "No SystemVerilog / Verilog files found in the workspace.\nOpen a folder that contains .sv/.svh/.v/.vh files."
      }
    ],
    "commands": [
      {
        "command": "systemverilogLsp.refreshHierarchy",
        "title": "Refresh Hierarchy",
        "icon": "$(refresh)"
      },
      {
        "command": "systemverilogLsp.openHierarchyNode",
        "title": "Open"
      },
      {
        "command": "systemverilogLsp.copyHierarchyPath",
        "title": "Copy Instance Path"
      },
      {
        "command": "systemverilogLsp.revealInEditor",
        "title": "Reveal in Editor"
      },
      {
        "command": "systemverilogLsp.showNodeMenu",
        "title": "Show Menu... (all entries, including run-time ones)",
        "category": "RTL Hierarchy"
      },
      {
        "command": "systemverilogLsp.hierarchy.addBlankFile",
        "title": "Blank File",
        "category": "RTL Hierarchy",
        "icon": "$(new-file)"
      },
      {
        "command": "systemverilogLsp.hierarchy.addFolder",
        "title": "Folder",
        "category": "RTL Hierarchy",
        "icon": {
          "light": "icons/folder.svg",
          "dark": "icons/folder-dark.svg"
        }
      },
      {
        "command": "systemverilogLsp.hierarchy.addSystemVerilogInterface",
        "title": "SystemVerilog interface",
        "category": "RTL Hierarchy",
        "icon": {
          "light": "icons/systemverilog-document.svg",
          "dark": "icons/systemverilog-document-dark.svg"
        }
      },
      {
        "command": "systemverilogLsp.hierarchy.addSystemVerilogModule",
        "title": "SystemVerilog module",
        "category": "RTL Hierarchy",
        "icon": {
          "light": "icons/systemverilog-document.svg",
          "dark": "icons/systemverilog-document-dark.svg"
        }
      },
      {
        "command": "systemverilogLsp.hierarchy.addVerilogModule",
        "title": "verilog module",
        "category": "RTL Hierarchy",
        "icon": {
          "light": "icons/verilog-document.svg",
          "dark": "icons/verilog-document-dark.svg"
        }
      },
      {
        "command": "systemverilogLsp.hierarchy.simulationSetup",
        "title": "Simulation Setup (files)",
        "category": "RTL Hierarchy"
      },
      {
        "command": "systemverilogLsp.hierarchy.deleteNode",
        "title": "Delete",
        "category": "RTL Hierarchy",
        "icon": "$(trash)"
      },
      {
        "command": "systemverilogLsp.hierarchy.openInExplorer",
        "title": "Open in Explorer",
        "category": "RTL Hierarchy",
        "icon": "$(folder-opened)"
      },
      {
        "command": "systemverilogLsp.hierarchy.copyInstancePath",
        "title": "Copy Instance Path",
        "category": "RTL Hierarchy",
        "icon": "$(clippy)"
      },
      {
        "command": "systemverilogLsp.hierarchy.copyPath",
        "title": "Copy Path",
        "category": "RTL Hierarchy",
        "icon": "$(clippy)"
      },
      {
        "command": "systemverilogLsp.hierarchy.showProperty",
        "title": "Property",
        "category": "RTL Hierarchy",
        "icon": "$(gear)"
      },
      {
        "command": "systemverilogLsp.runNodeMenuEntry",
        "title": "Run a specific RTL Hierarchy menu entry",
        "category": "RTL Hierarchy"
      },
      {
        "command": "systemverilogLsp.snippet.alwaysFF",
        "title": "Insert alwaysFF Block",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.autoFormat",
        "title": "AutoFormat Instance at Caret",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.moduleInstance",
        "title": "Insert Module Instance",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.portConnectionCreate",
        "title": "Fill Port Connections",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.portInvert",
        "title": "Invert Selected Ports",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.snippet.modport",
        "title": "Generate Modport",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.autoConnect",
        "title": "Auto Connect Ports",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.showToolMenu",
        "title": "Show Tool Menu (Shift+Space)",
        "category": "SystemVerilog Snippet"
      },
      {
        "command": "systemverilogLsp.showMessages",
        "title": "SystemVerilog: Show Messages",
        "icon": "$(warning)"
      },
      {
        "command": "systemverilogLsp.showLog",
        "title": "SystemVerilog LSP: Show Log",
        "icon": "$(output)"
      },
      {
        "command": "systemverilogLsp.showLogFilePath",
        "title": "SystemVerilog LSP: Copy Log File Path"
      }
    ],
    "menus": {
      "systemverilogLsp.hierarchySubmenu.add": [
        {
          "command": "systemverilogLsp.hierarchy.addBlankFile",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addBlankFile",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addBlankFile",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addFolder",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addFolder",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addFolder",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addSystemVerilogInterface",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addSystemVerilogInterface",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addSystemVerilogInterface",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addSystemVerilogModule",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addSystemVerilogModule",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addSystemVerilogModule",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addVerilogModule",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addVerilogModule",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.addVerilogModule",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        }
      ],
      "systemverilogLsp.hierarchySubmenu.simulation": [
        {
          "command": "systemverilogLsp.hierarchy.simulationSetup",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.simulationSetup",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        }
      ],
      "editor/context": [
        {
          "command": "systemverilogLsp.snippet.alwaysFF",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@1"
        },
        {
          "command": "systemverilogLsp.snippet.autoFormat",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@2"
        },
        {
          "command": "systemverilogLsp.snippet.moduleInstance",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@3"
        },
        {
          "command": "systemverilogLsp.snippet.portConnectionCreate",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@4"
        },
        {
          "command": "systemverilogLsp.snippet.portInvert",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@5"
        },
        {
          "command": "systemverilogLsp.snippet.modport",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@6"
        },
        {
          "command": "systemverilogLsp.autoConnect",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@7"
        },
        {
          "command": "systemverilogLsp.showToolMenu",
          "when": "editorLangId == systemverilog || editorLangId == verilog",
          "group": "systemverilogSnippet@0"
        }
      ],
      "view/title": [
        {
          "command": "systemverilogLsp.refreshHierarchy",
          "when": "view == systemverilogLsp.hierarchy",
          "group": "navigation"
        },
        {
          "command": "systemverilogLsp.showLog",
          "when": "view == systemverilogLsp.hierarchy",
          "group": "navigation"
        },
        {
          "command": "systemverilogLsp.showNodeMenu",
          "when": "view == systemverilogLsp.hierarchy",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "systemverilogLsp.revealInEditor",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "inline"
        },
        {
          "command": "systemverilogLsp.copyHierarchyPath",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "3_copy"
        },
        {
          "command": "systemverilogLsp.revealInEditor",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlInstance || viewItem == rtlFile)",
          "group": "0_open"
        },
        {
          "command": "systemverilogLsp.showNodeMenu",
          "when": "view == systemverilogLsp.hierarchy && (viewItem == rtlFolder || viewItem == rtlFile || viewItem == rtlInstance)",
          "group": "0_menu"
        },
        {
          "submenu": "systemverilogLsp.hierarchySubmenu.add",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "010_hierarchyMenu"
        },
        {
          "submenu": "systemverilogLsp.hierarchySubmenu.add",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "submenu": "systemverilogLsp.hierarchySubmenu.add",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        },
        {
          "submenu": "systemverilogLsp.hierarchySubmenu.simulation",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "010_hierarchyMenu"
        },
        {
          "submenu": "systemverilogLsp.hierarchySubmenu.simulation",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "010_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.deleteNode",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "020_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.deleteNode",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "020_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.openInExplorer",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "040_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.openInExplorer",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "040_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.openInExplorer",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "040_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.copyInstancePath",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "050_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.copyPath",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "050_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.copyPath",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "050_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.copyPath",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "050_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.showProperty",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFolder",
          "group": "060_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.showProperty",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlFile",
          "group": "060_hierarchyMenu"
        },
        {
          "command": "systemverilogLsp.hierarchy.showProperty",
          "when": "view == systemverilogLsp.hierarchy && viewItem == rtlInstance",
          "group": "060_hierarchyMenu"
        }
      ]
    },
    "keybindings": [
      {
        "command": "systemverilogLsp.showToolMenu",
        "key": "shift+space",
        "when": "editorTextFocus && !editorReadonly && (editorLangId == systemverilog || editorLangId == verilog)"
      }
    ],
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ]
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ]
      },
      {
        "id": "systemverilog-hover",
        "aliases": [
          "SystemVerilog (hover)"
        ]
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "keyword": "#569CD6",
          "comment": "#6A9955",
          "type": "#4EC9B0",
          "function": "#4EC9B0",
          "parameter": "#FF5EC2",
          "macro": "#FF5EC2",
          "property": "#FFC8C8",
          "variable": "#FFB4B4",
          "number": "#CE9178",
          "string": "#CE9178",
          "register": "#FF3232",
          "identifier": "#4EC9B0",
          "reference": "#D4D4D4",
          "annotation": "#C8FF64"
        }
      }
    },
    "configuration": {
      "title": "SystemVerilog LSP",
      "properties": {
        "systemverilogLsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to a SystemVerilogLanguageServer executable. Leave empty to use the server bundled under the extension's 'server' folder."
        }
      }
    }
  },
  "scripts": {
    "generate-menu": "node scripts/generate-hierarchy-menu.js",
    "check-menu": "node scripts/generate-hierarchy-menu.js --check",
    "generate-icons": "node scripts/generate-badge-icons.js",
    "check-icons": "node scripts/generate-badge-icons.js --check",
    "generate-hover-grammar": "node scripts/generate-hover-grammar.js",
    "check-hover-grammar": "node scripts/generate-hover-grammar.js --check",
    "bundle-server": "node scripts/bundle-server.js",
    "vsix": "node scripts/make-vsix.js",
    "vsix:fast": "node scripts/make-vsix.js --skip-bundle",
    "package": "node scripts/make-vsix.js",
    "package:nobundle": "node scripts/make-vsix.js --skip-bundle"
  }
}
